From 0123456789abcdef0123456789abcdef01234567 Mon Sep 17 00:00:00 2001
From: Ann Example <ann@example.com>
Date: Mon, 1 Jan 2024 00:00:00 +0000
Subject: [PATCH] Greet by name, and add a notes file

The greeting now says who it greets.
---
 greet.ts | 3 ++-
 notes.md | 2 ++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/greet.ts b/greet.ts
index 1111111..2222222 100644
--- a/greet.ts
+++ b/greet.ts
@@ -1,3 +1,4 @@
-export function greet(): string {
-  return "hello";
+export function greet(name: string): string {
+  // <b>names</b> arrive escaped on the page
+  return `hello, ${name}`;
 }
diff --git a/notes.md b/notes.md
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/notes.md
@@ -0,0 +1,2 @@
+# Notes
+Open this file on the forge to see it drawn as a diff.
-- 
