    "run": "node --max-old-space-size=1024 ./node_modules/typescript/lib/tsc.js --noEmit && FORGE_CHECK_SHARDS=1 bun scripts/test-shards.ts --timeout 60000 --gate",
    "timeout": 7200,
    "limits": {
      "memory": 4096,
      "cpus": 4,
      "disk": 8192
    }
  }
