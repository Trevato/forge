{
  "egress": [
    "api.anthropic.com"
  ],
  "app": {
    "run": "bun run src/main.ts",
    "install": "",
    "health": "/healthz",
    "ready": 90,
    "limits": {
      "memory": 2048,
      "cpus": 2,
      "disk": 8192
    }
  },
  "check": {
    "fast": "node --max-old-space-size=1024 ./node_modules/typescript/lib/tsc.js --noEmit && bun scripts/test-shards.ts --timeout 60000 --tier fast --diff $FORGE_CHECK_BASE..HEAD --learned \"$FORGE_CHECK_LEARNED\"",
    "run": "node --max-old-space-size=1024 ./node_modules/typescript/lib/tsc.js --noEmit && bun scripts/test-shards.ts --timeout 60000 --gate --impact",
    "timeout": 7200,
    "limits": {
      "memory": 8192,
      "cpus": 8,
      "disk": 8192
    }
  }
}
