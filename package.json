{
  "name": "forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "check": "bun run scripts/check.ts",
    "check:record": "bun run scripts/check.ts --record"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.9.0"
  }
}
