node_modules
data/
!src/data/
dist/
*.local
.DS_Store

# agent worktrees are separate checkouts, merged via git
.claude/worktrees/

# a TypeSafe API key, kept beside the forge, never in it
typesafe-api-key

# databases live under FORGE_APP_DATA or data/, never in the tree (#558)
/*.db
/*.db-wal
/*.db-shm
# a forge whose data directory was the checkout leaves these; boot now
# refuses that, and the gate refuses a tracked key or database (#622)
/forge.db*
/ssh/
/*.sock

# what a check keeps for the next one (src/checks/cache.ts)
/.forge-cache/

# empty stubs an agent sandbox mounts over home-directory config; never the
# forge's own files, and never committed (#1148)
/.bash_profile
/.bashrc
/.profile
/.zshrc
/.zprofile
/.gitconfig
/.gitmodules
/.idea
/.vscode
/.mcp.json
/.ripgreprc
/.claude/
# where a sandboxed `bun install` keeps its temp files and package cache
# when the default temp directory is read-only (#2706)
/.bun-tmp/

# a suite whose data would crowd a check cell's 256 MiB /tmp keeps it
# here, on the checkout's disk (test/helpers/scratch.ts)
/.test-scratch/

# a sandbox's bun/bunx scratch directory; never source
/.tmpx/
